APP_NAME=Marcio TopBarber API
APP_VERSION=1.1.0
APP_ENV=development

ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_RECEIVER=
EMAIL_USE_TLS=false
EMAIL_START_TLS=true

DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/marciotopbarber
SQL_ECHO=false
BUSINESS_TIMEZONE=America/Fortaleza
SLOT_INTERVAL_MINUTES=15
AUTH_SESSION_DURATION_HOURS=12

# Primeiro administrador, usado somente pelo comando de bootstrap:
# BOOTSTRAP_ADMIN_NAME=Administrador
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=troque-por-uma-senha-forte
# Google Identity Services
GOOGLE_CLIENT_ID=
PLATFORM_SUPERADMIN_EMAIL=helpus.ecommerce@gmail.com
GOOGLE_AUTO_PROVISION_CUSTOMERS=true
